    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "1.\u5712\u5340\u5167\u53EA\u6709\u5154\u5B50\u3001\u7F8A\u99DD\u548C\u9D28\u5B50\u3002\r\n2.\u5154\u5B50\u5340\u7684\u5154\u5B50\u5FC5\u9808\u4FDD\u6301\u5728\u5341\u4E09\u96BB\u7684\u6578\u91CF\u3002\r\n3.\u82E5\u767C\u73FE\u5154\u5B50\u51FA\u73FE\u5728\u5154\u5B50\u5340\u4EE5\u5916\u7684\u5730\u65B9\uFF0C\u8ACB\u5728\u9760\u8FD1\u5154\u5B50\u5F8C\u6309\u4E0B\n\u3000\uFF26\u9375\u6293\u6355\u5154\u5B50\uFF0C\u4E26\u5E36\u56DE\u5154\u5B50\u5340\u3002\r\n4.\u82E5\u767C\u73FE\u4E86\u5F62\u4F3C\u65BC\u5154\u5B50\u7684\u8089\u8272\u7121\u6BDB\u751F\u7269\uFF0C\u90A3\u4E26\u4E0D\u662F\u5154\u5B50\uFF0C\u8ACB\u6309\n\u3000F\u9375\u56DE\u6536\u8089\u584A\u3002\r\n5.\u82E5\u767C\u73FE\u6574\u500B\u5712\u5340\u5167\u5154\u5B50\u7684\u6578\u91CF\u4E0D\u8DB3\u5341\u4E09\u96BB\uFF0C\u53EF\u81F3\u751F\u7269\u8259\u9818\u53D6\n\u3000\u65B0\u5154\u5B50\u5E36\u56DE\u5154\u5B50\u5340\uFF1B\u82E5\u6574\u500B\u5712\u5340\u5167\u7684\u5154\u5B50\u591A\u65BC\u5341\u4E09\u96BB\uFF0C\u53EF\u5C07\n\u3000\u591A\u9918\u7684\u500B\u9AD4\u7E73\u56DE\u751F\u7269\u8259\u3002\r\n\n"
