    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "6.\u7F8A\u99DD\u5340\u7684\u7F8A\u99DD\u5FC5\u9808\u4FDD\u6301\u5728\u4E03\u96BB\u7684\u6578\u91CF\u3002\r\n7.\u82E5\u767C\u73FE\u7F8A\u99DD\u51FA\u73FE\u5728\u7F8A\u99DD\u5340\u4EE5\u5916\u7684\u5730\u65B9\uFF0C\u8ACB\u4F7F\u7528\u9EBB\u9189\u69CD\u64CA\u6688\u7F8A\n\u3000\u99DD\uFF0C\u4E26\u5C07\u5176\u5E36\u56DE\u7F8A\u99DD\u5340\u3002\r\n8.\u7F8A\u99DD\u6703\u5728\u4E0D\u5B89\u6642\u5410\u51FA\u553E\u6DB2\uFF0C\u82E5\u8EAB\u9AD4\u63A5\u89F8\u5230\u7F8A\u99DD\u7684\u553E\u6DB2\uFF0C\u6703\u8B93\n\u3000\u4F60\u66AB\u6642\u611F\u5230\u9EBB\u75FA\u3002\u9019\u662F\u6B63\u5E38\u73FE\u8C61\uFF0C\u7A0D\u5F85\u5E7E\u79D2\u4FBF\u6703\u6062\u5FA9\uFF0C\u4E26\u4E0D\n\u3000\u6703\u5C0D\u4F60\u7684\u8EAB\u9AD4\u9020\u6210\u5176\u4ED6\u5F8C\u907A\u75C7\uFF0C\u4F46\u9019\u6703\u4F7F\u4F60\u5DE5\u4F5C\u6548\u7387\u8B8A\u4F4E\uFF0C\n\u3000\u8ACB\u5728\u6293\u6355\u7F8A\u99DD\u6642\u6CE8\u610F\u8EB2\u907F\u553E\u6DB2\u3002\r\n9.\u9D28\u5B50\u5340\u7684\u9D28\u5B50\u5FC5\u9808\u4FDD\u6301\u5728\u56DB\u96BB\u7684\u6578\u91CF\u3002\r\n10.\u82E5\u767C\u73FE\u9D28\u5B50\u51FA\u73FE\u5728\u9D28\u5B50\u5340\u4EE5\u5916\u7684\u5730\u65B9\uFF0C\u8ACB\u5728\u9760\u8FD1\u9D28\u5B50\u5F8C\u6309\n\u3000\u4E0B\uFF26\u9375\u6293\u6355\u9D28\u5B50\uFF0C\u4E26\u5E36\u56DE\u9D28\u5B50\u5340\u3002\r\n11.\u5927\u591A\u6578\u7684\u9CE5\u985E\u90FD\u662F\u5371\u96AA\u7684\uFF0C\u9D28\u5B50\u9664\u5916\u3002\r\n"
