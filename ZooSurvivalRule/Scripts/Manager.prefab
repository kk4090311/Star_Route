    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "1.\u8ACB\u5728\u78BA\u4FDD\u81EA\u8EAB\u5B89\u5168\u7684\u60C5\u6CC1\u4E0B\u76E1\u53EF\u80FD\u5730\u5B8C\u6210\u4EFB\u52D9\u3002\r\n2.\u6E05\u6F54\u5DE5\u7B49\u7D1A\u6392\u5E8F\u70BAA\u3001B\u3001C\u3001D\u3001E\uFF0C\u6700\u4F4E\u968E\u7684\u54E1\u5DE5\u70BAE\u7D1A\uFF0C\n\u3000\u6700\u9AD8\u7D1A\u7684\u54E1\u5DE5\u70BAA\u7D1A\u3002\r\n3.\u5B8C\u6210\u4E00\u5B9A\u91CF\u7684\u4EFB\u52D9\u5F8C\uFF0C\u53EF\u4EE5\u7533\u8ACB\u8DF3\u7D1A\u8003\u8A66\u3002\r\n4.\u672C\u8077\u4F4D\u6C92\u6709\u300CS\u300D\u5206\u7D1A\uFF0C\u82E5\u770B\u898B\u7D1A\u6578\u70BA\u300CS\u300D\uFF0C\u8ACB\u7ACB\u523B\u96E2\u958B\u3002\r\n5.\u82E5\u9047\u5230\u7121\u6CD5\u5B8C\u6210\u4E14\u81EA\u8EAB\u4E5F\u8655\u5728\u5371\u96AA\u72C0\u6CC1\u4E0B\u7684\u4EFB\u52D9\uFF0C\u8ACB\u524D\u5F80\u6700\n\u3000\u8FD1\u7684\u5B89\u5168\u5C4B\uFF0C\u4E26\u78BA\u4FDD\u5DF2\u7D93\u901A\u77E5\u66F4\u9AD8\u968E\u7684\u6E05\u6F54\u5DE5\u3002\r\n"
